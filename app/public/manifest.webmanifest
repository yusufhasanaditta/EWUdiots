    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My routine", "url": "/app.html#/routine", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Advising planner", "url": "/app.html#/planner", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Sync portal", "url": "/app.html#/sync", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
