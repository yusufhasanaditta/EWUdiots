# Copy to .env and fill in from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Web push (VAPID) public key — safe to expose. Generate with: npx web-push generate-vapid-keys
# The matching private key goes in the server env only (VAPID_PRIVATE_KEY on Vercel), never in the app.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
